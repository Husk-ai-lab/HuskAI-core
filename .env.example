# Husk — local overrides only. Copy to .env (git-ignored, never committed or bundled).
#
# Public, non-secret product configuration lives in app/config.py (committed):
#   Clerk issuer + client id, husk-gateway URL, default models, Neon Data API URL, languages.
# Every value there can be overridden here for development or staging.
# The app needs NO AI key and no other secret: AI goes through husk-gateway with the user's login token.

# --- Optional overrides of app/config.py ------------------------------------------------
# CLERK_ISSUER=https://<instance>.clerk.accounts.dev
# CLERK_CLIENT_ID=
# HUSK_GATEWAY_URL=https://huskai-gateway-production.up.railway.app
# HUSK_LLM_MODEL=gpt-oss-120b
# HUSK_SUMMARY_MODEL=gpt-oss-20b
# HUSK_DECISION_MODEL=jev-latest          # empty = let the gateway choose
# HUSK_GATEWAY_RATE_PER_MINUTE=55         # the gateway allows 60 requests/minute/user
# HUSK_OPEN_BROWSER=true                  # login opens the system browser from the backend
# NEON_DATA_API_URL=https://ep-xxxx.apirest.<region>.aws.neon.tech/neondb/rest/v1
# NEON_AUTH_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth   # anonymous token endpoint base

# --- Benchmarks only (never read by the product) ------------------------------------------
# `benchmarks/` can call the providers directly with these keys (live runs). The product does not.
# REGOLO_API_KEY=
# VENICE_API_KEY=
# OPENROUTER_API_KEY=

# --- Local runtime (normally passed by the desktop shell) --------------------------------
# HUSK_PORT=8765            # must match the redirect URI registered in Clerk: http://127.0.0.1:8765/callback
# HUSK_DATA_DIR=            # default: OS application-data folder (ai.husk.desktop)
# HUSK_LAUNCH_SECRET=       # protects /internal/* (Husk Studio token endpoint)
# HUSK_ENV=dev              # dev | prod
# HUSK_FRONTEND_DEV_URL=http://localhost:5173   # only with `npm run dev`

# --- Husk Studio (optional, development only, loopback only) -----------------------------
# HUSK_STUDIO_UI_URL=http://127.0.0.1:7654
# HUSK_STUDIO_OTLP_URL=http://127.0.0.1:7654
# HUSK_STUDIO_MCP_URL=http://127.0.0.1:7655/mcp
# HUSK_STUDIO_RUN_URL_TEMPLATE={base}/runs/{trace_id}
